{
    "compilerOptions": {
        "module": "nodenext",
        "target": "esnext",
        "types": ["jest", "node"],
        "sourceMap": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    }
}
